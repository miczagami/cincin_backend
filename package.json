    "express-rate-limit": "^8.3.0",
    "express-validator": "^7.3.0",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.0",
    "node-cron": "^3.0.3",
