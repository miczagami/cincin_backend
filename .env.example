# ─── Core ───
# Set NODE_ENV=production in production: it disables mock payments and mock age
# verification, and makes JWT_SECRET mandatory.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cincin:cincin@localhost:5432/cincin
# Optional — how long GET /health waits for its database query (default 2000ms)
# HEALTH_DB_TIMEOUT_MS=2000
# Optional — the API runs without Redis
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Per-IP requests per 15 minutes: all /api routes, and /api/auth on top
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
# Header carrying the real client IP when the API runs behind a proxy (Sevalla: cf-connecting-ip).
# Leave empty unless all traffic reaches the API through that proxy — clients could spoof it otherwise.
CLIENT_IP_HEADER=

# ─── URLs ───
# Frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:3000
# The app's URL, used in emailed links, push links and Stripe returns (default: https://app.playcincin.com)
APP_URL=http://localhost:3000

# ─── Social login (ID token audiences; comma-separated for web + iOS/Android) ───
# Google: OAuth client ID(s). Apple: Services ID (web) and/or app bundle ID.
# Social login is rejected while these are empty.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ─── AI (label scanning + guess evaluation) ───
# AI runs on Anthropic only. AI_VISION_PROVIDER / AI_LLM_PROVIDER are no longer needed;
# set to anything but "anthropic", they stop the API at startup.
ANTHROPIC_API_KEY=
# Claude models per role. The defaults below apply when unset. When a model is retired,
# change these, not the code. The fallback model runs if the first one errors or refuses.
AI_VISION_MODEL=claude-sonnet-5-5
AI_VISION_FALLBACK_MODEL=claude-haiku-5-5
# Guess evaluation, mid-game: keep it fast
AI_LLM_MODEL=claude-haiku-5-5
AI_LLM_FALLBACK_MODEL=claude-sonnet-5-5
# Tasting-note synthesis
AI_SYNTHESIS_MODEL=claude-sonnet-5-5
AI_SYNTHESIS_FALLBACK_MODEL=claude-haiku-5-5
AI_VISION_TIMEOUT_MS=15000
AI_GUESS_TIMEOUT_MS=4000
AI_SYNTHESIS_TIMEOUT_MS=60000
# "us" keeps inference in the US (1.1x price). Leave empty for global routing.
AI_INFERENCE_GEO=

# ─── Age verification ───
# onfido | mock (dev only; also enables POST /age-verify/manual). jumio is not implemented yet.
AGE_VERIFY_PROVIDER=mock
# Onfido API base — use the region your account lives in
AGE_VERIFY_API_BASE=https://api.eu.onfido.com/v3.6
AGE_VERIFY_API_KEY=
AGE_VERIFY_WEBHOOK_SECRET=

# ─── Stripe (mock mode when STRIPE_SECRET_KEY is empty — development only) ───
# Webhooks are rejected unless both STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# ─── Email (SendGrid) ───
# Without a key, account emails (verify / reset links) are logged to the console outside production.
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@playcincin.com
EMAIL_FROM_NAME=CinCin
SG_TEMPLATE_PAYMENT_FAILED=
SG_TEMPLATE_SEASON_ENDED=
SG_TEMPLATE_MEMBERSHIP_REDUCED=
SG_TEMPLATE_MONTHLY_WRAPPED=
SG_TEMPLATE_QUARTERLY_SUMMARY=
SG_TEMPLATE_SEASON_END_REPORT=

# ─── Push notifications ───
# Service account JSON string, the same JSON base64-encoded, or a path to the JSON file
FIREBASE_SERVICE_ACCOUNT=
# Path to the .p8 key file, or the key's contents (-----BEGIN PRIVATE KEY----- ...)
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.playcincin.app

# ─── Scheduled jobs ───
CRON_ENABLED=true
