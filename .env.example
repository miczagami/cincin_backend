# ─── Core ───
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cincin:cincin@localhost:5432/cincin
# Optional — the API runs without Redis
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ─── URLs ───
# Frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
SHARE_BASE_URL=http://localhost:3000
# Public URL of this API (used for provider callbacks)
API_BASE_URL=http://localhost:4000

# ─── AI (label scanning + guess evaluation) ───
# anthropic | openai | google
AI_VISION_PROVIDER=anthropic
# anthropic | openai
AI_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=

# ─── Age verification ───
# mock | onfido | jumio
AGE_VERIFY_PROVIDER=mock
AGE_VERIFY_API_KEY=
AGE_VERIFY_API_SECRET=
AGE_VERIFY_WEBHOOK_SECRET=

# ─── Stripe (mock mode when STRIPE_SECRET_KEY is empty) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# ─── Email (SendGrid; logged to console when empty) ───
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@getcincin.com
EMAIL_FROM_NAME=CinCin
SG_TEMPLATE_PAYMENT_FAILED=
SG_TEMPLATE_SEASON_ENDED=
SG_TEMPLATE_MEMBERSHIP_REDUCED=
SG_TEMPLATE_MONTHLY_WRAPPED=
SG_TEMPLATE_QUARTERLY_SUMMARY=
SG_TEMPLATE_SEASON_END_REPORT=

# ─── Push notifications ───
# Service account JSON string, or a path to the JSON file
FIREBASE_SERVICE_ACCOUNT=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.getcincin.app

# ─── Scheduled jobs ───
CRON_ENABLED=true
