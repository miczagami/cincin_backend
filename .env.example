# ─── Core ───
# Set NODE_ENV=production in production: it disables mock payments and mock age
# verification, and makes JWT_SECRET mandatory.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cincin:cincin@localhost:5432/cincin
# Optional — the API runs without Redis
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# Per-IP requests per 15 minutes: all /api routes, and /api/auth on top
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# ─── URLs ───
# Frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:3000
# Frontend URL used in emailed verification / password-reset links
APP_URL=http://localhost:3000
SHARE_BASE_URL=http://localhost:3000
# Public URL of this API (used for provider callbacks)
API_BASE_URL=http://localhost:4000

# ─── Social login (ID token audiences; comma-separated for web + iOS/Android) ───
# Google: OAuth client ID(s). Apple: Services ID (web) and/or app bundle ID.
# Social login is rejected while these are empty.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ─── AI (label scanning + guess evaluation) ───
# anthropic | openai | google
AI_VISION_PROVIDER=anthropic
# anthropic | openai
AI_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=

# ─── Age verification ───
# onfido | mock (dev only; also enables POST /age-verify/manual). jumio is not implemented yet.
AGE_VERIFY_PROVIDER=mock
# Onfido API base — use the region your account lives in
AGE_VERIFY_API_BASE=https://api.eu.onfido.com/v3.6
AGE_VERIFY_API_KEY=
AGE_VERIFY_API_SECRET=
AGE_VERIFY_WEBHOOK_SECRET=

# ─── Stripe (mock mode when STRIPE_SECRET_KEY is empty — development only) ───
# Webhooks are rejected unless both STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# ─── Email (SendGrid) ───
# Without a key, account emails (verify / reset links) are logged to the console outside production.
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@getcincin.com
EMAIL_FROM_NAME=CinCin
SG_TEMPLATE_PAYMENT_FAILED=
SG_TEMPLATE_SEASON_ENDED=
SG_TEMPLATE_MEMBERSHIP_REDUCED=
SG_TEMPLATE_MONTHLY_WRAPPED=
SG_TEMPLATE_QUARTERLY_SUMMARY=
SG_TEMPLATE_SEASON_END_REPORT=

# ─── Push notifications ───
# Service account JSON string, or a path to the JSON file
FIREBASE_SERVICE_ACCOUNT=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.getcincin.app

# ─── Scheduled jobs ───
CRON_ENABLED=true
